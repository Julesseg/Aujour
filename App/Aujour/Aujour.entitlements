<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Aujour's own iCloud Drive folder: the default Journal Root. The
	     container's Documents folder is what the user sees in the Files app,
	     what syncs between their devices, and what is still there after the
	     app is deleted (ADR 0001). The same identifier appears in
	     Info.plist's NSUbiquitousContainers and is derived at runtime in
	     JournalRootLocator. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.julesseguin.aujour</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.julesseguin.aujour</string>
	</array>
	<!-- The journal-shaping settings — Path Template, Content Template,
	     Rollover Hour — travel between the user's devices through iCloud
	     key-value storage rather than a config file in the Journal Root,
	     which is somebody's Obsidian vault (ADR 0003). Two devices with
	     different Path Templates would write the same day to two paths.
	     Read through SyncedSettingsStorage, which mirrors it on the device
	     so the settings survive iCloud being unreachable. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
