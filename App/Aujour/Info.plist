<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Everything else in this app's Info.plist is generated from the
	     INFOPLIST_KEY_* build settings. This file exists for the one key that
	     has no such setting because its value is a dictionary — and it is the
	     key that makes the journal a folder the user owns rather than app
	     storage they can't see.

	     IsDocumentScopePublic puts the container's Documents folder in the
	     Files app under iCloud Drive › Aujour; SupportedFolderLevels = Any
	     lets the Path Template nest entries in YYYY/MM subfolders there.

	     Apple only re-reads these when the app's version changes, so a change
	     here needs MARKETING_VERSION or CURRENT_PROJECT_VERSION bumped with
	     it, or the folder keeps its old visibility. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.julesseguin.aujour</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Aujour</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
</dict>
</plist>
